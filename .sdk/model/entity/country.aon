# Entity: country

main: kit: entity: country: {

  alias: field: {}

  fields: [
    {
      name: "Iso2"
      req: false
      type: "`$STRING`"
    }
    {
      name: "Iso3"
      req: false
      type: "`$STRING`"
    }
    {
      name: "capital"
      req: false
      type: "`$STRING`"
    }
    {
      name: "cities"
      req: false
      short: "List of cities in the country"
      type: "`$ARRAY`"
    }
    {
      name: "code"
      req: false
      short: "Country code"
      type: "`$STRING`"
    }
    {
      name: "country"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
        list: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "Country name"
      type: "`$STRING`"
    }
    {
      name: "currency"
      req: false
      type: "`$STRING`"
    }
    {
      name: "flag"
      req: false
      short: "URL to the country flag image"
      type: "`$STRING`"
    }
    {
      name: "iso2"
      req: false
      short: "ISO 3166-1 alpha-2 code"
      type: "`$STRING`"
    }
    {
      name: "iso3"
      req: false
      short: "ISO 3166-1 alpha-3 code"
      type: "`$STRING`"
    }
    {
      name: "lat"
      req: false
      short: "Latitude"
      type: "`$NUMBER`"
    }
    {
      name: "long"
      req: false
      short: "Longitude"
      type: "`$NUMBER`"
    }
    {
      name: "name"
      req: false
      short: "Country name"
      type: "`$STRING`"
    }
    {
      name: "populationCounts"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "states"
      req: false
      type: "`$ARRAY`"
    }
  ]

  name: "country"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/countries/capital"
          parts: [
            "countries"
            "capital"
          ]
          select: {
            "$action": "capital"
          }
          transform: {
            req: {
              country: "`reqdata`"
            }
            res: "`body.data`"
          }
        }
        {
          method: "POST"
          orig: "/countries/currency"
          parts: [
            "countries"
            "currency"
          ]
          select: {
            "$action": "currency"
          }
          transform: {
            req: {
              country: "`reqdata`"
            }
            res: "`body.data`"
          }
        }
        {
          method: "POST"
          orig: "/countries/flag/images"
          parts: [
            "countries"
            "flag"
            "images"
          ]
          transform: {
            req: {
              country: "`reqdata`"
            }
            res: "`body.data`"
          }
        }
        {
          method: "POST"
          orig: "/countries/iso"
          parts: [
            "countries"
            "iso"
          ]
          select: {
            "$action": "iso"
          }
          transform: {
            req: {
              country: "`reqdata`"
            }
            res: "`body.data`"
          }
        }
        {
          method: "POST"
          orig: "/countries/population"
          parts: [
            "countries"
            "population"
          ]
          select: {
            "$action": "population"
          }
          transform: {
            req: {
              country: "`reqdata`"
            }
            res: "`body.data`"
          }
        }
        {
          method: "POST"
          orig: "/countries/positions"
          parts: [
            "countries"
            "positions"
          ]
          select: {
            "$action": "position"
          }
          transform: {
            req: {
              country: "`reqdata`"
            }
            res: "`body.data`"
          }
        }
        {
          method: "POST"
          orig: "/countries/states"
          parts: [
            "countries"
            "states"
          ]
          select: {
            "$action": "state"
          }
          transform: {
            req: {
              country: "`reqdata`"
            }
            res: "`body.data`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/countries"
          parts: [
            "countries"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
        {
          method: "GET"
          orig: "/countries/codes"
          parts: [
            "countries"
            "codes"
          ]
          select: {
            "$action": "code"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
        {
          method: "GET"
          orig: "/countries/flag/images"
          parts: [
            "countries"
            "flag"
            "images"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
        {
          method: "GET"
          orig: "/countries/population"
          parts: [
            "countries"
            "population"
          ]
          select: {
            "$action": "population"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
        {
          method: "GET"
          orig: "/countries/positions"
          parts: [
            "countries"
            "positions"
          ]
          select: {
            "$action": "position"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
