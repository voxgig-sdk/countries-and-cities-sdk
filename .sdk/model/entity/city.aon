            json: "{\"operationId\":\"getStateCities\",\"parameters\":[],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"country\":{\"example\":\"Nigeria\",\"type\":\"string\"},\"state\":{\"example\":\"Lagos\",\"type\":\"string\"}},\"required\":[\"country\",\"state\"],\"type\":\"object\"}}},\"required\":true},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"data\":{\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"error\":{\"type\":\"boolean\"},\"msg\":{\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Successful response\"}},\"securitySource\":\"unspecified\"}"
